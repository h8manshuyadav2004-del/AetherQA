{
  "name": "web-application-test-ai-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "install:playwright": "playwright install",
    "setup": "node setup.js",
    "test": "echo \"Run npm run dev:full to start the testing platform\"",
    "test:ui": "echo \"UI Agent testing - use the web interface\"",
    "test:functional": "echo \"Functional Agent testing - use the web interface\"",
    "test:database": "echo \"Database Agent testing - use the web interface\"",
    "test:intelligence": "echo \"Intelligence systems testing - use the web interface\"",
    "health": "curl http://localhost:3001/api/health || echo \"Server not running. Run 'npm run server' first.\"",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "postinstall": "echo \"✅ Installation complete! Run 'npm run dev:full' to start the platform.\""
  },
  "dependencies": {
    "@google/genai": "^1.21.0",
    "axios": "^1.6.0",
    "chart.js": "^4.5.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "mongodb": "^5.9.0",
    "mysql2": "^3.6.0",
    "pg": "^8.11.0",
    "playwright": "^1.40.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "sql.js": "^1.8.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "testing",
    "automation",
    "ai",
    "multi-agent",
    "playwright",
    "web-testing",
    "e2e-testing",
    "api-testing",
    "database-testing"
  ]
}
